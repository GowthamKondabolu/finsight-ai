FINSIGHT_ENVIRONMENT=local
FINSIGHT_LOG_LEVEL=INFO
FINSIGHT_SEC_USER_AGENT="FinSightAI/0.1 your-email@example.com"
FINSIGHT_SEC_REQUEST_TIMEOUT_SECONDS=30
FINSIGHT_SEC_REQUESTS_PER_SECOND=5
FINSIGHT_SEC_RETRY_ATTEMPTS=4

FINSIGHT_OPENAI_API_KEY=
FINSIGHT_EXPERIMENT_ASSIGNMENT_SECRET=
FINSIGHT_EMBEDDING_MODEL=text-embedding-3-small
FINSIGHT_EMBEDDING_DIMENSIONS=1536
FINSIGHT_EMBEDDING_BATCH_SIZE=100
FINSIGHT_GENERATION_MODEL=gpt-5.6-luna
FINSIGHT_GENERATION_MAX_OUTPUT_TOKENS=2000
FINSIGHT_GENERATION_REASONING_EFFORT=low

FINSIGHT_DATABASE_URL=
FINSIGHT_DATABASE_ECHO=false
FINSIGHT_DATABASE_POOL_SIZE=5
FINSIGHT_DATABASE_MAX_OVERFLOW=10
FINSIGHT_DATABASE_POOL_TIMEOUT_SECONDS=30

POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Server-side Next.js proxy target; never expose database or provider secrets to the browser.
FINSIGHT_API_BASE_URL=http://127.0.0.1:8000
